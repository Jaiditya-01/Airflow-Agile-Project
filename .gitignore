# ──────────────────────────────────────────
# Node.js
# ──────────────────────────────────────────
node_modules/

# Temporary files created by npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# ──────────────────────────────────────────
# Environment files (secrets)
# ──────────────────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────────────────
# Uploads (temporary file storage)
# ──────────────────────────────────────────
uploads/

# ──────────────────────────────────────────
# Build / Distribution / Coverage
# ──────────────────────────────────────────
dist/
build/
out/
coverage/
*.tgz

# ──────────────────────────────────────────
# Cache folders
# ──────────────────────────────────────────
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/

# ──────────────────────────────────────────
# OS-generated files
# ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
Icon?
ehthumbs.db

# ──────────────────────────────────────────
# IDE / Editor folders and files
# ──────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.sublime-project

# Editor temporary / swap files
*~
*.swp
*.swo

